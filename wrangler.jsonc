{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tdea-design",
  "main": "src/point-stats-entry.js",
  "compatibility_date": "2026-07-17",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*", "/v1/*", "/internal/*", "/i/*", "/w/*", "/c/*", "/r/*", "/akaffit-official", "/akaffit-official-runtime", "/akaffit-official-slick.js", "/akaffit-official-slick.css", "/akaffit-official-slick-theme.css", "/akaffit-official-font/*", "/admin", "/admin/*", "/admin.html", "/assets/checkin-template/*"]
  },
  "vars": {
    "LIFF_ID": "2005868456-3Ip8H1Bx",
    "CARD_SHARE_LIFF_ID": "2005868456-3Ip8H1Bx",
    "CHECKIN_LIFF_ID": "2005868456-3Ip8H1Bx",
    "LINE_LOGIN_CHANNEL_ID": "2005868456",
    "APP_BASE_URL": "https://tdea-design.fangwl591021.workers.dev",
    "LIFF_URL": "https://liff.line.me/2005868456-3Ip8H1Bx"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tdea_design_crm",
      "database_id": "7518faf2-a05a-4f25-996f-6968d4c92c72",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["*/10 * * * *"] },
  "services": [
    {
      "binding": "MLM_WORKER",
      "service": "mlm"
    },
    {
      "binding": "TDEA_WORKER",
      "service": "tdeawork"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "tdea-design-media"
    }
  ]
}
